# Solo aplica si el sitio se sirve desde Hostinger/Apache-LiteSpeed (Vercel lo ignora).
# Subir el contenido de dist/ (incluido este archivo) a public_html/.

RewriteEngine On

# 1) HTTPS y sin www (el canonical del sitio es https://aoaglobalservices.com/)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aoaglobalservices.com%{REQUEST_URI} [L,R=301]

# 2) Rutas prerenderizadas sin barra final → con barra (coincide con el canonical)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# 3) Cualquier otra ruta → index.html (la app decide; las rutas viejas redirigen a la home)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# 4) Caché: assets con hash un año; HTML siempre revalidado
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# 5) Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
